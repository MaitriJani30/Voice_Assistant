# Streamlit secrets (protects your API keys)
.streamlit/secrets.toml
.streamlit/secrets.toml:1
# Environment variables
.env
.env.*

# Virtual environments
venv/
env/
.venv/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

